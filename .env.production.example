# ==========================================
# FitLog 生产环境配置模板 (.env.production.example)
# ==========================================
# 适用架构：Ubuntu 24.04 宿主机原生部署 + Cloudflare Tunnel 暴露
# 生产部署时请复制为 /opt/fitlog/server/.env 并填入真实强密码 (chmod 600)

# --- 基础运行环境 ---
NODE_ENV=production
PORT=3001
# 填入经由 Cloudflare Tunnel 绑定的真实 HTTPS 访问域名
CORS_ORIGIN=https://fitlog.yourdomain.com

# --- 宿主机 MySQL 8.0 数据库配置 ---
# 独立数据库 fitlog_prod，独立应用用户 fitlog_user
# 格式: mysql://<USER>:<PASSWORD>@127.0.0.1:3306/<DATABASE>
DATABASE_URL=mysql://fitlog_user:your_secure_db_password_here@127.0.0.1:3306/fitlog_prod

# --- 宿主机 Redis 7.x 缓存与限流驱动 ---
# 复用宿主机 Redis 实例，分配独立 DB 1 (NetDisk 使用 DB 0)
# 格式: redis://:<PASSWORD>@127.0.0.1:6379/1
REDIS_URL=redis://:your_secure_redis_password_here@127.0.0.1:6379/1
VERIFICATION_STORE=redis
RATE_LIMITER=redis

# --- 生产短信服务 (SMS) ---
# 当前阶段使用 mock 模拟驱动，不产生外部短信资费
SMS_PROVIDER=mock

# --- JWT 认证密钥 (必须使用高强度随机字符，至少32位) ---
# 在 Linux 生成推荐命令: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_very_long_secure_random_string_32_chars_min # 占位符：部署前必须替换为 openssl rand -hex 32 生成的随机值
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_very_long_secure_random_string_32_chars # 占位符：同上，必须与 ACCESS 不同
JWT_REFRESH_EXPIRES_IN=7d

# --- 生产邮件服务 (SMTP) (可选) ---
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fitlog.example.com
SMTP_PASS=your_smtp_auth_password
EMAIL_FROM=FitLog团队 <noreply@fitlog.example.com>
