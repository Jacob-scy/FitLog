# ==========================================
# FitLog Docker Compose 环境变量模板
# ==========================================
# 用法：复制为 .env（与 docker-compose.yml 同目录，chmod 600），填入强密码。
# 本文件仅占位，禁止提交真实值。

# --- MySQL 容器 ---
MYSQL_ROOT_PASSWORD=changeme_strong_root_password
MYSQL_DATABASE=fitlog_prod
MYSQL_USER=fitlog_user
MYSQL_PASSWORD=changeme_strong_app_password

# --- Redis 容器 ---
REDIS_PASSWORD=changeme_strong_redis_password

# --- server 服务连接串（需与上面的账号密码保持一致；主机名用服务名 mysql / redis）---
DATABASE_URL=mysql://fitlog_user:changeme_strong_app_password@mysql:3306/fitlog_prod
REDIS_URL=redis://:changeme_strong_redis_password@redis:6379/0

# --- JWT（openssl rand -hex 32 生成）---
JWT_ACCESS_SECRET=changeme_long_random_access_secret
JWT_REFRESH_SECRET=changeme_long_random_refresh_secret

# --- 其他 ---
CORS_ORIGIN=https://fitlog.jacobscy.xyz
