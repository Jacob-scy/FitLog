DATABASE_URL="mysql://fitlog:YOUR_DB_PASSWORD@localhost:3306/fitlog"
JWT_ACCESS_SECRET="generate-a-random-secret-here" # 占位符：请替换为随机值
JWT_REFRESH_SECRET="generate-another-random-secret-here" # 占位符：同上，必须与 ACCESS 不同
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
EMAIL_MODE="dev" # "production" to send real emails
PORT=3001
NODE_ENV="development"

# SMTP Settings for real email sending
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@qq.com"
SMTP_PASS="your-smtp-auth-password"
SMTP_FROM="FitLog <your-email@qq.com>"
